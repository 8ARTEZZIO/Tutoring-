# Copy to workers/public/.dev.vars for local development. Never commit the real file.
ENVIRONMENT=development
PUBLIC_ORIGIN=http://localhost:8787
ADMIN_ORIGIN=http://localhost:8788
APP_SECRET=dev-only-change-me-dev-only-change-me-0001
# Stripe TEST mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Printed by: stripe listen --forward-to localhost:8787/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Cloudflare Turnstile test keys (always pass). Leave both empty to skip the widget in local dev.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
