# Copy to workers/public/.secrets for the FIRST deploy only, fill in, deploy with
#   npx wrangler deploy -c workers/public/wrangler.jsonc --secrets-file workers/public/.secrets
# then delete the file. Later changes: npx wrangler secret put NAME -c workers/public/wrangler.jsonc
APP_SECRET=generate-with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
TURNSTILE_SECRET_KEY=0x...
